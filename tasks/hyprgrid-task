#!/usr/bin/env python3
"""Load task modules from the source checkout or the installed lib directory."""
from pathlib import Path
import sys

directory = Path(__file__).resolve().parent
modules = directory if (directory / "cli.py").is_file() else directory.parent / "lib/hyprgrid-task"
sys.path.insert(0, str(modules))
from cli import main

sys.exit(main())
